+
+
+def test_declared_decimal_asymptomatic_bias_cancellation_is_exact() -> None:
+    truth = CandidateCell(0.08, 2, 0.75, 0.25)
+    asymptomatic_values = (0.40, 0.10, 0.25, 0.25, 0.25)
+    rows = tuple(
