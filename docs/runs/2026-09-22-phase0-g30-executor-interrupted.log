+    dimension: str, endpoint: float | int, tolerance: float
+) -> None:
+    truth = CandidateCell(0.08, 2, 0.75, 0.25)
+    endpoint_selection = replace(truth, **{dimension: endpoint})
+    rows = tuple(
+        RecoveryRow(
